NUXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/david-minguela-7167bb98/
NUXT_PUBLIC_EMAIL=email@example.com

# Keep local content active until a Neon branch has been backed up, migrated,
# imported, and read-back verified.
NUXT_CONTENT_SOURCE=local
# Set NUXT_CONTENT_SOURCE=neon and provide DATABASE_URL only after that gate.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk admin stays fail-closed until an instance and owner are configured.
# NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# (or NUXT_CLERK_SECRET_KEY at runtime)
# NUXT_CONTENT_ADMIN_USER_IDS=user_...
# NUXT_CLERK_AUTHORIZED_PARTIES=https://dminguela.es,https://<preview-domain>

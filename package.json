{
  "name": "landing",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "content-store": "node --experimental-strip-types --import=./scripts/register-ts-extension-loader.mjs ./scripts/content-store.mjs",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host",
    "test": "node --experimental-strip-types --import=./tests/register-ts-extension-loader.mjs --test tests/*.test.mjs",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@clerk/nuxt": "^3.1.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "nuxt": "^4.4.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.2",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=22"
  }
}
